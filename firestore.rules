rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCustomerAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'defaultAddress', 'defaultCity', 'defaultPinCode', 'wishlistIds', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'defaultAddress', 'defaultCity', 'defaultPinCode', 'wishlistIds', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.defaultAddress is string && data.defaultAddress.size() <= 300 &&
        data.defaultCity is string && data.defaultCity.size() <= 80 &&
        data.defaultPinCode is string && data.defaultPinCode.size() <= 6 &&
        data.defaultPinCode.matches('^$|^[1-9][0-9]{5}$') &&
        data.wishlistIds is list && data.wishlistIds.size() <= 50 &&
        (data.wishlistIds.size() == 0 || (data.wishlistIds[0] is string && data.wishlistIds[0].size() <= 64)) &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerOrder(data, userId) {
      return data.keys().hasAll([
          'uid', 'orderNumber', 'status', 'paymentMethod', 'customerName', 'email',
          'address', 'city', 'pinCode', 'itemsSummary', 'itemCount', 'subtotal',
          'couponDiscount', 'shippingFee', 'total', 'estimatedDelivery', 'placedAt', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'orderNumber', 'status', 'paymentMethod', 'customerName', 'email',
          'address', 'city', 'pinCode', 'itemsSummary', 'itemCount', 'subtotal',
          'couponCode', 'couponDiscount', 'shippingFee', 'total', 'estimatedDelivery', 'placedAt', 'createdAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 &&
        data.orderNumber.matches('^[A-Z0-9\\-]+$') &&
        data.status in ['Confirmed', 'Packed', 'In Transit', 'Delivered'] &&
        data.paymentMethod in ['UPI', 'Card', 'COD'] &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        data.pinCode is string && data.pinCode.size() == 6 && data.pinCode.matches('^[1-9][0-9]{5}$') &&
        data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 600 &&
        data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 100 &&
        data.subtotal is number && data.subtotal >= 0 &&
        (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 32)) &&
        data.couponDiscount is number && data.couponDiscount >= 0 &&
        data.shippingFee is number && data.shippingFee >= 0 &&
        data.total is number && data.total >= 0 &&
        data.estimatedDelivery is string && data.estimatedDelivery.size() >= 1 && data.estimatedDelivery.size() <= 140 &&
        data.placedAt is string && data.placedAt.size() >= 10 && data.placedAt.size() <= 40 &&
        data.createdAt is timestamp;
    }

    function isValidCustomerBooking(data, userId) {
      return data.keys().hasAll([
          'uid', 'bookingCode', 'serviceId', 'serviceName', 'storeId', 'storeName',
          'date', 'timeSlot', 'customerName', 'email', 'notes', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'bookingCode', 'serviceId', 'serviceName', 'storeId', 'storeName',
          'date', 'timeSlot', 'customerName', 'email', 'notes', 'status', 'createdAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.bookingCode is string && data.bookingCode.size() >= 3 && data.bookingCode.size() <= 32 &&
        data.bookingCode.matches('^[A-Z0-9\\-]+$') &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 64 &&
        data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 140 &&
        data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 64 &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 140 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 24 &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.notes is string && data.notes.size() <= 400 &&
        data.status in ['Confirmed', 'Completed'] &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isVerifiedOwner(userId) &&
        isValidCustomerAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedOwner(userId) &&
        isValidCustomerAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'profile' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) && docId == 'profile' &&
          isVerifiedOwner(userId) &&
          isValidPrivateProfile(incoming(), userId) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(docId) && docId == 'profile' &&
          isVerifiedOwner(userId) &&
          isValidPrivateProfile(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'defaultAddress', 'defaultCity', 'defaultPinCode', 'wishlistIds', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if false;
      }

      match /orders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(orderId) &&
          isVerifiedOwner(userId) &&
          isValidCustomerOrder(incoming(), userId) &&
          incoming().status == 'Confirmed' &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if false;
      }

      match /bookings/{bookingId} {
        allow get: if isValidId(userId) && isValidId(bookingId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(bookingId) &&
          isVerifiedOwner(userId) &&
          isValidCustomerBooking(incoming(), userId) &&
          incoming().status == 'Confirmed' &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
